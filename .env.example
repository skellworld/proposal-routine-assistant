# AI 연결(Claude·ChatGPT API 키)은 사용자마다 웹 화면 '⚙ 내 AI 연결'에서 설정합니다. 여기에 키를 넣지 않습니다.

# 선택: Claude 기본 모델과 추론 강도(low | medium | high | xhigh | max)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high

# 선택: 0.0.0.0이면 같은 망의 다른 PC에서 http://이PC의IP:8000 으로 접속 가능 (기본 127.0.0.1 = 이 PC 전용)
# 방화벽에서 TCP 8000 인바운드 허용이 필요하고, https가 아니므로 신뢰할 수 있는 사내망에서만 쓰세요.
HOST=127.0.0.1

# 선택: 외부 접속 고정 주소 (Cloudflare 이름 있는 터널). 비워 두면 manage.py tunnel start가 임시 주소를 발급합니다.
# Cloudflare 대시보드 > Zero Trust > Networks > Tunnels 에서 만든 터널의 토큰과, 연결한 도메인 주소
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_URL=
